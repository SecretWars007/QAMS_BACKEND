# ============================================================
# QAMS Backend – Variables de Entorno (Pre-Producción)
# Copia este archivo como .env.prod y completa los valores
# NUNCA versiones el archivo .env.prod con valores reales
# ============================================================

# ---- Base de datos PostgreSQL ----
POSTGRES_USER=qams_user
POSTGRES_PASSWORD=CAMBIAR_CONTRASENA_SEGURA
POSTGRES_DB=qams_prod

# ---- JWT Authentication (mínimo 64 caracteres aleatorios) ----
JWT_SECRET=CAMBIAR_SECRET_MINIMO_64_CARACTERES_ALEATORIOS_AQUI_!!2025QAMS
JWT_ISSUER=QAMS.Api
JWT_AUDIENCE=QAMS.Client
JWT_EXPIRY_MINUTES=60

# ---- Cifrado AES-256 ----
# KEY: exactamente 32 caracteres
ENCRYPTION_KEY=CAMBIAR_CLAVE_32_CARACTERES_AQUI
# IV: exactamente 16 caracteres
ENCRYPTION_IV=CAMBIAR_IV_16CHARS

# ---- Correo SMTP ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=correo@ejemplo.com
SMTP_PASSWORD=contraseña_app_gmail
SMTP_FROM_EMAIL=correo@ejemplo.com

# ---- Frontend URL (para CORS) ----
# En pre-producción usar la IP del servidor o localhost
FRONTEND_URL=http://localhost:4200

# ---- Redis ----
REDIS_HOST=qams-redis
REDIS_PORT=6379

# ---- Ambiente ----
ASPNETCORE_ENVIRONMENT=Production
