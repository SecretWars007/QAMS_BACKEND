##############################################
# .gitignore — QAMS (.NET 9 / Docker / EF Core)
##############################################

# ── .NET / MSBuild ─────────────────────────
[Bb]in/
[Oo]bj/
*.user
*.suo
*.userosscache
*.sln.docstates
project.lock.json
project.fragment.lock.json
artifacts/

# ── Publicaciones ──────────────────────────
[Pp]ublish/
[Pp]ublish[Oo]utput/
*.pubxml
*.pubxml.user

# ── NuGet ──────────────────────────────────
*.nupkg
*.snupkg
**/[Pp]ackages/
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets
nuget.config

# ── Rider / JetBrains ──────────────────────
.idea/
*.sln.iml

# ── Visual Studio ──────────────────────────
.vs/
*.VC.db
*.VC.opendb
*.vcxproj.filters
*.pidb
*.svclog
*.scc
ipch/
*.ncb
*.aps
*.pch
*.psm1
*.opensdf
*.opendb
*.VC.VC.opendb

# ── VS Code ────────────────────────────────
.vscode/
!.vscode/extensions.json

# ── Test results ───────────────────────────
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
coverage.*
*.coveragexml
BenchmarkDotNet.Artifacts/

# ── Logs de la app y archivos de depuración temporales ──
logs/
*.log
*.log.*
src/QAMS.Api/logs/

# ── Archivos de diagnóstico / scripts temporales en raíz ──
*.txt
*.json
!docker-compose.yml
!DOCKER.md
!SWAGGER_SETUP.md
!README.md

# Scripts de diagnóstico sueltos (no son parte del proyecto)
db_diag.ps1
sql_diag.ps1
get_dashboard.ps1
test_kanban_endpoints.ps1
verify_execution_post.ps1
verify_testcase.ps1
init-admin.sql

# ── Docker ─────────────────────────────────
# No ignorar docker-compose.yml ni Dockerfile → son parte del proyecto
# Ignorar archivos de entorno locales con secretos
*.env
.env
.env.*
!.env.example
appsettings.Docker.env
src/QAMS.Api/appsettings.Docker.env

# ── Secretos y configuración local ─────────
appsettings.Local.json
appsettings.Development.json
**/appsettings.*.env

# ── SO ─────────────────────────────────────
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~

# ── Otros ──────────────────────────────────
*.bak
*.tmp
*.swp
*.orig
